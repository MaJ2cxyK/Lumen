{
  "name": "lumen",
  "private": true,
  "version": "0.1.3",
  "license": "MIT",
  "author": "MaJ2cxyK",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaJ2cxyK/Lumen.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "ui:clip-audit": "node scripts/clip-audit.mjs",
    "gate:ui": "npm run build && npm run ui:clip-audit",
    "build:signed": "tauri build --config src-tauri/tauri.signing.conf.json --no-binary-patching --bundles nsis",
    "sign:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signature.ps1 -AllowUnsigned",
    "sign:verify:strict": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signature.ps1",
    "guard:public": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-public-repo.ps1",
    "updater:key": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gen-updater-key.ps1",
    "release:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "release:ci": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-ci.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
